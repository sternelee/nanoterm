+//! nanoterm's in-process fx entry point.
+//!
+//! This is the native Zig agent runtime: provider streaming, tools, MCP,
+//! skills, sessions, and compaction all execute in this address space.
+
+const std = @import("std");
+const cli_ask = @import("core/cli/cli_ask.zig");
+const builtin_gateway = @import("builtins/gateway.zig");
+const builtin_providers = @import("builtins/providers.zig");
+const builtin_context = @import("builtins/context.zig");
+const builtin_skills = @import("builtins/skills.zig");
+const builtin_modes = @import("builtins/modes.zig");
+const builtin_tools = @import("builtins/tools.zig");
+const builtin_mcp = @import("builtins/mcp.zig");
+const native_host = @import("core/hosts/native.zig");
+const shell_process_provider = @import("tools/shell/process_provider.zig");
+const command_runner = @import("core/execution/command_runner.zig");
+const terminal_native_session = @import("core/terminal/native_session.zig");
+const context_contract = @import("core/workspace/context_contract.zig");
+const agent_steps = @import("core/config/agent_steps.zig");
+const tool_result_limits = @import("core/tooling/tool_result_limits.zig");
+
+pub const Result = cli_ask.PromptRunResult;
+pub const Callbacks = cli_ask.EmbeddedCallbacks;
+pub const Config = cli_ask.Config;
+pub const ImageAttachment = cli_ask.ImageAttachment;
+pub const mcp_config = @import("core/mcp_host/config_file.zig");
+pub const skills = builtin_skills;
+pub const provider_settings = @import("core/config/config_runtime.zig");
+pub const model_provider = @import("core/config/model_provider.zig");
+pub const shared_io = @import("core/shared/io.zig");
+pub const ExtraStdioServer = builtin_mcp.ExtraStdioServer;
+
+/// The tool names one configured MCP server offers, for hosts that list them
+/// outside a model turn. `deinit` frees everything.
+pub const McpToolList = struct {
+    names: [][]u8 = &.{},
+    /// Why there are no names, when the server could not be asked.
+    note: ?[]u8 = null,
+
+    pub fn deinit(self: *McpToolList, alloc: std.mem.Allocator) void {
+        for (self.names) |name| alloc.free(name);
+        if (self.names.len > 0) alloc.free(self.names);
+        if (self.note) |text| alloc.free(text);
+        self.* = .{};
+    }
+};
+
+/// Lists `server`'s tools from the profile config at `config_path`. This runs
+/// the server over MCP and blocks; call it off the UI thread and hand it a
+/// cancel flag.
+pub fn listMcpTools(
+    alloc: std.mem.Allocator,
+    home: []const u8,
+    config_path: []const u8,
+    workspace_root: []const u8,
+    server: []const u8,
+    cancel: ?*const std.atomic.Value(bool),
+) !McpToolList {
+    var configs = try builtin_mcp.loadConfigFromPath(alloc, config_path);
+    defer {
+        for (configs.items) |*entry| entry.deinit(alloc);
+        configs.deinit(alloc);
+    }
+
+    var environ = try shared_io.cloneEnvironMap(alloc);
+    defer environ.deinit();
+
+    var runtime: @import("core/mcp_host/runtime.zig").Runtime = undefined;
+    try runtime.start(alloc, shared_io.getIo(), configs.items, &environ, .{
+        .client_version = "nanoterm",
+        .credentials = .{ .detect = home },
+        .workspace_root = workspace_root,
+    });
+    defer runtime.deinit();
+
+    const result = runtime.tools(alloc, server, cancel) catch |err| {
+        return .{ .note = try alloc.dupe(u8, @errorName(err)) };
+    };
+    switch (result) {
+        .tools => |tools| {
+            var list: McpToolList = .{};
+            errdefer list.deinit(alloc);
+            list.names = try alloc.alloc([]u8, tools.len);
+            @memset(list.names, &.{});
+            for (tools, 0..) |tool, i| list.names[i] = try alloc.dupe(u8, tool.name);
+            for (tools) |tool| {
+                alloc.free(tool.name);
+                alloc.free(tool.raw);
+            }
+            alloc.free(tools);
+            return list;
+        },
+        .needs_login => return .{ .note = try alloc.dupe(u8, "the server needs sign-in") },
+        .failed => |text| {
+            defer alloc.free(text);
+            return .{ .note = try alloc.dupe(u8, text) };
+        },
+        .unknown_server => return .{ .note = try alloc.dupe(u8, "server not found") },
+    }
+}
+
+/// Handles fx's private re-execution entrypoints inside the host executable.
+/// Returns false for nanoterm's ordinary UI and CLI arguments.
+pub fn runInternal(init: std.process.Init) !bool {
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    const cli_args = if (args.len > 0) args[1..] else args;
+    const terminal_mode = if (comptime terminal_native_session.isSupported())
+        terminal_native_session.isControlMode(cli_args) or terminal_native_session.isLauncherMode(cli_args)
+    else
+        false;
+    if (!terminal_mode and !command_runner.isForegroundSessionInvocation(cli_args)) return false;
+
+    shared_io.setIo(init.io);
+    shared_io.setEnvironMap(init.environ_map);
+    if (comptime terminal_native_session.isSupported()) {
+        if (terminal_native_session.isControlMode(cli_args)) {
+            try terminal_native_session.runControl(cli_args);
+            return true;
+        }
+        if (terminal_native_session.isLauncherMode(cli_args)) {
+            try terminal_native_session.runLauncher(init.gpa);
+            return true;
+        }
+    }
+    try command_runner.runForegroundSessionBootstrap(cli_args);
+    return true;
+}
