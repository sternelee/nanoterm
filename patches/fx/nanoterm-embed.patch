--- /dev/null
+++ b/src/embedded.zig
@@ -0,0 +1,277 @@
+//! nanoterm's in-process fx entry point.
+//!
+//! This is the native Zig agent runtime: provider streaming, tools, MCP,
+//! skills, sessions, and compaction all execute in this address space.
+
+const std = @import("std");
+const cli_ask = @import("core/cli/cli_ask.zig");
+const builtin_gateway = @import("builtins/gateway.zig");
+const auth_runtime = @import("core/auth/auth_runtime.zig");
+const credentials = @import("core/auth/credentials.zig");
+const model_catalog = @import("core/gateway/model_catalog.zig");
+const io_mod = @import("core/shared/io.zig");
+const builtin_providers = @import("builtins/providers.zig");
+const builtin_context = @import("builtins/context.zig");
+const builtin_skills = @import("builtins/skills.zig");
+const builtin_modes = @import("builtins/modes.zig");
+const builtin_tools = @import("builtins/tools.zig");
+const builtin_mcp = @import("builtins/mcp.zig");
+const native_host = @import("core/hosts/native.zig");
+const shell_process_provider = @import("tools/shell/process_provider.zig");
+const command_runner = @import("core/execution/command_runner.zig");
+const terminal_native_session = @import("core/terminal/native_session.zig");
+const context_contract = @import("core/workspace/context_contract.zig");
+const agent_steps = @import("core/config/agent_steps.zig");
+const tool_result_limits = @import("core/tooling/tool_result_limits.zig");
+
+pub const Result = cli_ask.PromptRunResult;
+pub const Callbacks = cli_ask.EmbeddedCallbacks;
+pub const Config = cli_ask.Config;
+pub const ImageAttachment = cli_ask.ImageAttachment;
+pub const mcp_config = @import("core/mcp_host/config_file.zig");
+pub const skills = builtin_skills;
+pub const provider_settings = @import("core/config/config_runtime.zig");
+pub const model_provider = @import("core/config/model_provider.zig");
+pub const shared_io = @import("core/shared/io.zig");
+pub const ExtraStdioServer = builtin_mcp.ExtraStdioServer;
+
+/// The tool names one configured MCP server offers, for hosts that list them
+/// outside a model turn. `deinit` frees everything.
+pub const McpToolList = struct {
+    names: [][]u8 = &.{},
+    /// Why there are no names, when the server could not be asked.
+    note: ?[]u8 = null,
+
+    pub fn deinit(self: *McpToolList, alloc: std.mem.Allocator) void {
+        for (self.names) |name| alloc.free(name);
+        if (self.names.len > 0) alloc.free(self.names);
+        if (self.note) |text| alloc.free(text);
+        self.* = .{};
+    }
+};
+
+/// Lists `server`'s tools from the profile config at `config_path`. This runs
+/// the server over MCP and blocks; call it off the UI thread and hand it a
+/// cancel flag.
+pub fn listMcpTools(
+    alloc: std.mem.Allocator,
+    home: []const u8,
+    config_path: []const u8,
+    workspace_root: []const u8,
+    server: []const u8,
+    cancel: ?*const std.atomic.Value(bool),
+) !McpToolList {
+    var configs = try builtin_mcp.loadConfigFromPath(alloc, config_path);
+    defer {
+        for (configs.items) |*entry| entry.deinit(alloc);
+        configs.deinit(alloc);
+    }
+
+    var environ = try shared_io.cloneEnvironMap(alloc);
+    defer environ.deinit();
+
+    var runtime: @import("core/mcp_host/runtime.zig").Runtime = undefined;
+    try runtime.start(alloc, shared_io.getIo(), configs.items, &environ, .{
+        .client_version = "nanoterm",
+        .credentials = .{ .detect = home },
+        .workspace_root = workspace_root,
+    });
+    defer runtime.deinit();
+
+    const result = runtime.tools(alloc, server, cancel) catch |err| {
+        return .{ .note = try alloc.dupe(u8, @errorName(err)) };
+    };
+    switch (result) {
+        .tools => |tools| {
+            var list: McpToolList = .{};
+            errdefer list.deinit(alloc);
+            list.names = try alloc.alloc([]u8, tools.len);
+            @memset(list.names, &.{});
+            for (tools, 0..) |tool, i| list.names[i] = try alloc.dupe(u8, tool.name);
+            for (tools) |tool| {
+                alloc.free(tool.name);
+                alloc.free(tool.raw);
+            }
+            alloc.free(tools);
+            return list;
+        },
+        .needs_login => return .{ .note = try alloc.dupe(u8, "the server needs sign-in") },
+        .failed => |text| {
+            defer alloc.free(text);
+            return .{ .note = try alloc.dupe(u8, text) };
+        },
+        .unknown_server => return .{ .note = try alloc.dupe(u8, "server not found") },
+    }
+}
+
+/// The model ids one provider offers. `deinit` frees everything.
+pub const ProviderModelList = struct {
+    ids: [][]u8 = &.{},
+    /// Why there are no ids, when the provider's catalog could not be read.
+    note: ?[]u8 = null,
+    /// That note is the provider asking to be signed in to: a state to show,
+    /// not a failure.
+    needs_sign_in: bool = false,
+
+    pub fn deinit(self: *ProviderModelList, alloc: std.mem.Allocator) void {
+        for (self.ids) |id| alloc.free(id);
+        if (self.ids.len > 0) alloc.free(self.ids);
+        if (self.note) |text| alloc.free(text);
+        self.* = .{};
+    }
+};
+
+/// Lists the models `provider` offers, as fx resolves them for itself: the
+/// Gateway's catalog (public, or private when a key is signed in), or a
+/// subscription's own list (Codex, Grok), whose credential fx reads from the
+/// profile. This blocks on the network and on the profile's credentials; call
+/// it off the UI thread and hand it a cancel flag.
+pub fn listProviderModels(
+    alloc: std.mem.Allocator,
+    provider: model_provider.ProviderId,
+    cancel: ?*std.atomic.Value(bool),
+) !ProviderModelList {
+    const cfg = config();
+    const catalog_provider = cfg.provider_set.select(provider).model_catalog orelse
+        return .{ .note = try alloc.dupe(u8, "this provider has no model list") };
+    // The Gateway answers without a credential; Codex and Grok do not, so a
+    // profile without one asks anyway and hears what fx says about it.
+    var credential = auth_runtime.prepareCredential(
+        alloc,
+        cfg.gateway_provider.oauth_transport,
+        cfg.secret_store,
+        provider,
+        null,
+    ) catch |err| switch (err) {
+        error.OutOfMemory => return error.OutOfMemory,
+        else => null,
+    };
+    defer if (credential) |*value| value.deinit(alloc);
+    const access = if (credential) |*value|
+        credentials.catalogAccessAt(value.*, io_mod.milliTimestamp())
+    else
+        credentials.CatalogAccess{ .public_only = .no_credential };
+    var fallback_cancel = std.atomic.Value(bool).init(false);
+    const result = model_catalog.fetchWithPublicFallback(catalog_provider, alloc, .{
+        .access = access,
+        .endpoint = if (provider == .gateway) cfg.gateway_models_path else "",
+        .cancel_flag = cancel orelse &fallback_cancel,
+        .view = .picker,
+    });
+    switch (result) {
+        .loaded => |loaded| {
+            var catalog = loaded.catalog;
+            defer model_catalog.freeModelCatalog(alloc, &catalog);
+            var ids = model_catalog.projectModelIds(alloc, catalog.items) catch |err| switch (err) {
+                error.OutOfMemory => return error.OutOfMemory,
+            };
+            return .{ .ids = try ids.toOwnedSlice(alloc) };
+        },
+        .failed => |failed| return .{
+            .note = try alloc.dupe(u8, catalogFailurePhrase(failed.failure.category)),
+            .needs_sign_in = failed.failure.category == .authentication,
+        },
+    }
+}
+
+/// Why a provider's catalog could not be read, in fx's own words: what the
+/// host shows about that provider, rather than an internal error name.
+fn catalogFailurePhrase(category: model_catalog.FailureCategory) []const u8 {
+    return switch (category) {
+        .authentication => "not signed in",
+        .rate_limited => "rate limited by the provider",
+        .gateway_unavailable => "the gateway is unavailable",
+        .cancellation => "the listing was cancelled",
+        .transport => "the network could not reach it",
+        .malformed_response => "its answer could not be read",
+        .http_status => "it answered with an error",
+        .resource_exhausted => "out of memory",
+        .runtime => "fx could not read it",
+    };
+}
+
+/// Handles fx's private re-execution entrypoints inside the host executable.
+/// Returns false for nanoterm's ordinary UI and CLI arguments.
+pub fn runInternal(init: std.process.Init) !bool {
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    const cli_args = if (args.len > 0) args[1..] else args;
+    const terminal_mode = if (comptime terminal_native_session.isSupported())
+        terminal_native_session.isControlMode(cli_args) or terminal_native_session.isLauncherMode(cli_args)
+    else
+        false;
+    if (!terminal_mode and !command_runner.isForegroundSessionInvocation(cli_args)) return false;
+
+    shared_io.setIo(init.io);
+    shared_io.setEnvironMap(init.environ_map);
+    if (comptime terminal_native_session.isSupported()) {
+        if (terminal_native_session.isControlMode(cli_args)) {
+            try terminal_native_session.runControl(cli_args);
+            return true;
+        }
+        if (terminal_native_session.isLauncherMode(cli_args)) {
+            try terminal_native_session.runLauncher(init.gpa);
+            return true;
+        }
+    }
+    try command_runner.runForegroundSessionBootstrap(cli_args);
+    return true;
+}
+
+const ignored_list_entries = [_][]const u8{
+    ".git", ".zig-cache", "zig-out", "node_modules", ".next", "dist", "build", "coverage",
+};
+
+pub fn config() Config {
+    return .{
+        .command_usage = "nanoterm fx",
+        .default_model = builtin_gateway.default_model,
+        .default_agent_step_limit = agent_steps.default_max_agent_steps,
+        .gateway_retry_count = builtin_gateway.retry_count,
+        .gateway_chat_url = builtin_gateway.default_chat_url,
+        .gateway_models_path = builtin_gateway.models_path,
+        .gateway_provider = builtin_gateway.provider,
+        .provider_set = builtin_providers.native,
+        .process_provider = shell_process_provider.provider,
+        .secret_store = native_host.secret_store,
+        .prompt_policy = builtin_context.prompt_policy,
+        .skill_root_policy = builtin_skills.root_policy,
+        .ignored_list_entries = &ignored_list_entries,
+        .max_list_entries = 100,
+        .max_read_file_bytes = 50 * 1024,
+        .max_read_file_lines = 400,
+        .max_read_file_line_len = 2000,
+        .max_command_output_bytes = 64 * 1024,
+        .max_tool_result_bytes = tool_result_limits.default_max_tool_result_bytes,
+        .max_history_turns = 8,
+        .mode_registry = builtin_modes.registry,
+        .load_mcp_host = builtin_mcp.loadHost,
+    };
+}
+
+pub fn run(
+    alloc: std.mem.Allocator,
+    prompt: []const u8,
+    workspace_root: []const u8,
+    session_id: ?[]const u8,
+    model: ?[]const u8,
+    images: []const ImageAttachment,
+    cancel_flag: *std.atomic.Value(bool),
+    callbacks: Callbacks,
+    extra_mcp: ?ExtraStdioServer,
+) !Result {
+    return cli_ask.runEmbedded(
+        alloc,
+        prompt,
+        true,
+        config(),
+        .{ .default_provider = builtin_context.provider },
+        builtin_tools.advertisement_set,
+        if (session_id) |id| .{ .id = id } else null,
+        model,
+        workspace_root,
+        images,
+        cancel_flag,
+        callbacks,
+        extra_mcp,
+    );
+}
