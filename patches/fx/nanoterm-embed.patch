diff --git a/src/builtins/mcp.zig b/src/builtins/mcp.zig
index dbd510f8..c89c60e8 100644
--- a/src/builtins/mcp.zig
+++ b/src/builtins/mcp.zig
@@ -118,14 +118,45 @@ fn skipUnprintableNames(alloc: Allocator, loaded: *NativeConfigs) Allocator.Erro
 /// The MCP host for the workspace, or null when no server is configured and
 /// there is nothing to report. Its servers start when the model first needs
 /// them.
+pub const ExtraStdioServer = struct {
+    name: []const u8,
+    command: []const u8,
+    args: []const []const u8,
+};
+
 pub fn loadHost(
     alloc: Allocator,
     workspace_root: []const u8,
     builtins: tool_dispatch.Registry,
     extras: mcp_host.Extras,
+) !?*mcp_host.Host {
+    return loadHostWithExtra(alloc, workspace_root, builtins, extras, null);
+}
+
+/// `loadHost`, plus one host-issued stdio server (nanoterm's show_visual
+/// endpoint) that joins the profile and workspace servers for this run.
+pub fn loadHostWithExtra(
+    alloc: Allocator,
+    workspace_root: []const u8,
+    builtins: tool_dispatch.Registry,
+    extras: mcp_host.Extras,
+    extra: ?ExtraStdioServer,
 ) !?*mcp_host.Host {
     var loaded = try loadNativeConfigs(alloc, workspace_root);
     defer loaded.deinit(alloc);
+    if (extra) |server| {
+        // A host-issued server replaces a profile entry using its name.
+        var i: usize = 0;
+        while (i < loaded.configs.items.len) {
+            if (std.mem.eql(u8, loaded.configs.items[i].name, server.name)) {
+                var removed = loaded.configs.orderedRemove(i);
+                removed.deinit(alloc);
+                continue;
+            }
+            i += 1;
+        }
+        try loaded.configs.append(alloc, try cloneExtraServer(alloc, server));
+    }
     const home = io_mod.homeDir() orelse return null;
     // Read only while the host starts.
     var inherited = try io_mod.cloneEnvironMap(alloc);
@@ -158,6 +189,31 @@ pub fn loadHost(
     return h;
 }
 
+fn cloneExtraServer(alloc: Allocator, server: ExtraStdioServer) !McpServerConfig {
+    const name = try alloc.dupe(u8, server.name);
+    errdefer alloc.free(name);
+    const command = try alloc.dupe(u8, server.command);
+    errdefer alloc.free(command);
+    const args = try alloc.alloc([]const u8, server.args.len);
+    var initialized: usize = 0;
+    errdefer {
+        for (args[0..initialized]) |arg| alloc.free(arg);
+        alloc.free(args);
+    }
+    for (server.args, args) |arg, *owned| {
+        owned.* = try alloc.dupe(u8, arg);
+        initialized += 1;
+    }
+    return .{
+        .name = name,
+        .source = .acp,
+        .scope = .acp_session,
+        .always_loaded = true,
+        .command = command,
+        .args = args,
+    };
+}
+
 /// Each diagnostic in a sentence, owned by `alloc`.
 fn renderNotes(alloc: Allocator, diagnostics: []const project_config.WorkspaceDiagnostic) ![]const []const u8 {
     const notes = try alloc.alloc([]const u8, diagnostics.len);
